# Copy to .env, fill in real values, and keep it out of git (already covered
# by .dockerignore). Never commit real credentials; never bake them into the
# Docker image — pass via `docker run --env-file .env` or your
# orchestrator's secrets mechanism instead.

# --- Omie ERP credentials -------------------------------------------------
OMIE_APP_KEY=
OMIE_APP_SECRET=

# --- OAuth (required for the HTTP transport) ------------------------------
# The HTTP transport refuses to start unless these two are set, because this
# server can create orders, settle payables and adjust stock in a live ERP.
#
# MCP_AUTH_ISSUER: the OIDC issuer that mints access tokens.
# MCP_AUTH_RESOURCE: this server's canonical URL, exactly as entered in the
#   client. Tokens must carry it in `aud` — that binding is what stops a token
#   issued for a different service on the same IdP from working here.
MCP_AUTH_ISSUER=
MCP_AUTH_RESOURCE=

# Escape hatch for a port that is genuinely unreachable from anywhere
# untrusted (e.g. a stdio-only or loopback-only deployment). Leaving this
# "true" on a network-reachable port exposes the ERP to anyone who can
# reach it.
# MCP_INSECURE_HTTP=true
